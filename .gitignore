# JetBrains IDE — normalisation fine plutôt que blanket-ignore de .idea/ :
# fichiers d'état perso/machine ignores, structure/style partages committes.
# cf. https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf/
.idea/**/httpRequests/
.idea/**/caches/
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/sonarlint/
.idea/**/replstate.xml
.idea/*.iml
.idea/material_theme_project_new.xml
.idea/go.imports.xml
*.iws
out/

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.ruff_cache/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# k3d / kubeconfig
kubeconfig*.yaml
*.kubeconfig

# Secrets
.env
.env.*
!.env.example
*.secrets.yaml
secrets/

# Playwright : storage_state (cookies de session GitHub authentifiée) -
# jamais committe, meme accidentellement. Voir CLAUDE.md section captures.
playwright/.auth/

# Dataset brut (déposé localement par chaque membre, jamais committé —
# voir CLAUDE.md / SECURITY.md)
data/raw/

# graphify (outillage agent - voir CLAUDE.md section "Graphify").
# graphify-out/ est destine a etre committe pour l'equipe, SAUF les fichiers
# machine-locaux (chemins absolus) et le scratch/cache de build ci-dessous :
#   graph.json, GRAPH_REPORT.md, graph.html, manifest.json  -> committer
#   cost.json, .graphify_python, .graphify_root, cache/     -> jamais
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_*.json
graphify-out/.graphify_*.json.sig
graphify-out/.needs_update
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# LaTeX build artifacts (tectonic)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
report/*.pdf

# Materiel proprietaire du sujet - garde en local si besoin, jamais committe
docs/sujet/*.pdf
docs/sujet/*.docx
documentation/*.pdf
documentation/*.docx
