# Copier en .env (gitignored) et adapter si besoin. Valeurs par défaut
# ci-dessous déjà utilisées par les services si .env est absent — ce
# fichier documente les variables attendues, il n'est jamais lu directement.

# Doit rester "hive"/"hive"/"metastore" sauf si HIVE_SITE_CONF_javax_jdo_*
# dans compose.yaml est aussi ajusté (l'image bde2020/hive-metastore-postgresql
# initialise la base avec ces identifiants au premier démarrage).
POSTGRES_DB=metastore
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive

# Token d'accès au Jupyter partagé par l'équipe (stack locale uniquement,
# jamais exposée au-delà de localhost — voir SECURITY.md).
JUPYTER_TOKEN=bigdata
